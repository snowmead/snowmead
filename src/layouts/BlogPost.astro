---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  headings?: MarkdownHeading[];
  ogImage?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  headings = [],
  ogImage,
} = Astro.props;
---

<Base title={title} description={description} image={ogImage}>
  <TableOfContents headings={headings} />

  <article>
    <header class="mb-10">
      <h1
        class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
      >
        {title}
      </h1>
      <div
        class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400"
      >
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>· updated <FormattedDate date={updatedDate} /></span>
          )
        }
        {
          tags.length > 0 && (
            <span class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                  {tag}
                </span>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <div
      class="prose prose-zinc max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-sky-600 hover:prose-a:text-sky-500 prose-pre:bg-transparent prose-pre:p-0 dark:prose-invert dark:prose-a:text-sky-400"
    >
      <slot />
    </div>
  </article>

  <div class="mt-16">
    <a
      href="/blog"
      class="text-sm text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      ← All posts
    </a>
  </div>
</Base>
