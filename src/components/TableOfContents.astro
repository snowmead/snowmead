---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Posts use h2/h3 for sections; the title (h1) and deeper headings are skipped.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  toc.length > 0 && (
    <div class="toc">
      {/* Collapsed: a stack of right-aligned tick lines (decorative). */}
      <ul class="toc-rail" aria-hidden="true">
        {toc.map((h) => (
          <li>
            <span class:list={['toc-tick', `toc-d${h.depth}`]} data-slug={h.slug} />
          </li>
        ))}
      </ul>

      {/* Expanded: the labelled card that crossfades in on hover/focus. */}
      <nav class="toc-card" aria-label="Table of contents">
        <ul>
          {toc.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={['toc-link', `toc-d${h.depth}`]}
                data-slug={h.slug}
              >
                <span class="toc-bar" aria-hidden="true" />
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<style>
  /*
   * Two stacked layers anchored to the same right edge: a collapsed rail of tick
   * lines and an expanded labelled card. Hover/focus crossfades between them using
   * only opacity + transform (GPU-composited) — no width/layout animation, so the
   * reveal is smooth and never reflows the article.
   */
  .toc {
    position: fixed;
    top: 50%;
    right: 1.5rem;
    transform: translateY(-50%);
    z-index: 30;
    display: none;
  }

  /* Only show once the centered column leaves enough gutter room. */
  @media (min-width: 1152px) {
    .toc {
      display: block;
    }
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Collapsed rail --- */
  .toc-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    padding: 0.5rem 0;
    opacity: 1;
    transition: opacity 0.18s ease;
  }

  .toc-tick {
    display: block;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--color-zinc-300);
    transition:
      width 0.2s ease,
      background-color 0.2s ease;
  }
  :global(.dark) .toc-tick {
    background-color: var(--color-zinc-700);
  }
  .toc-tick.toc-d2 {
    width: 1.5rem;
  }
  .toc-tick.toc-d3 {
    width: 1rem;
  }
  /* Active section: elongated, sky tick — readable even while collapsed. */
  .toc-tick.is-active {
    width: 2rem;
    background-color: var(--color-sky-500);
  }

  /* --- Expanded card --- */
  .toc-card {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%) translateX(0.5rem);
    min-width: 12rem;
    max-width: 16rem;
    padding: 0.5rem;
    border: 1px solid var(--color-zinc-200);
    border-radius: 0.75rem;
    background-color: var(--color-white);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 12px 32px rgb(0 0 0 / 0.12);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.dark) .toc-card {
    border-color: var(--color-zinc-800);
    background-color: var(--color-zinc-900);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.2),
      0 12px 32px rgb(0 0 0 / 0.45);
  }

  /* Crossfade: fade the rail out, the card in. */
  .toc:hover .toc-rail,
  .toc:focus-within .toc-rail {
    opacity: 0;
  }
  .toc:hover .toc-card,
  .toc:focus-within .toc-card {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) translateX(0);
  }

  .toc-card li + li {
    margin-top: 0.125rem;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--color-zinc-500);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  /* Nest depth-3 under depth-2. */
  .toc-link.toc-d3 {
    padding-left: 1.25rem;
  }

  .toc-bar {
    flex: none;
    width: 0.75rem;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--color-zinc-300);
    transition:
      width 0.15s ease,
      background-color 0.15s ease;
  }
  :global(.dark) .toc-bar {
    background-color: var(--color-zinc-700);
  }

  .toc-text {
    font-size: 0.8125rem;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-zinc-900);
    background-color: var(--color-zinc-100);
    outline: none;
  }
  :global(.dark) .toc-link:hover,
  :global(.dark) .toc-link:focus-visible {
    color: var(--color-zinc-100);
    background-color: var(--color-zinc-800);
  }
  .toc-link:hover .toc-bar,
  .toc-link:focus-visible .toc-bar {
    background-color: var(--color-sky-500);
  }

  /* Active row in the card. */
  .toc-link.is-active {
    color: var(--color-sky-600);
  }
  :global(.dark) .toc-link.is-active {
    color: var(--color-sky-400);
  }
  .toc-link.is-active .toc-bar {
    width: 1.25rem;
    background-color: var(--color-sky-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-rail,
    .toc-tick,
    .toc-card,
    .toc-link,
    .toc-bar {
      transition: none;
    }
  }
</style>

<script>
  // Deterministic scrollspy: the active section is the last heading whose top has
  // scrolled above an activation line near the top of the viewport. No dead zones,
  // no jitter between observer entries.
  const ACTIVATION_OFFSET = 96; // px from the top

  const ticks = Array.from(
    document.querySelectorAll<HTMLElement>('.toc-tick[data-slug]'),
  );
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-slug]'),
  );

  if (links.length) {
    const slugs = links.map((l) => l.dataset.slug ?? '');
    const headings = slugs.map((s) => document.getElementById(s));

    let activeSlug = '';
    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      for (const el of [...ticks, ...links]) {
        el.classList.toggle('is-active', el.dataset.slug === slug);
      }
    };

    const computeActive = () => {
      let current = slugs[0];
      for (let i = 0; i < headings.length; i++) {
        const h = headings[i];
        if (h && h.getBoundingClientRect().top <= ACTIVATION_OFFSET) {
          current = slugs[i];
        } else {
          break;
        }
      }
      setActive(current);
    };

    // rAF-throttled scroll handler.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        computeActive();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Highlight immediately on click instead of waiting for the smooth scroll.
    for (const link of links) {
      link.addEventListener('click', () => setActive(link.dataset.slug ?? ''));
    }

    computeActive();
  }
</script>
