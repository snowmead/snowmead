---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Posts use h2/h3 for sections; the title (h1) and deeper headings are skipped.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  toc.length > 0 && (
    <nav class="toc" aria-label="Table of contents">
      <ul>
        {toc.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={['toc-link', `toc-d${h.depth}`]}
              data-slug={h.slug}
            >
              <span class="toc-bar" aria-hidden="true" />
              <span class="toc-text">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /*
   * An always-visible table of contents anchored to the right edge of the
   * centered article column, so it sits right beside the text instead of out at
   * the viewport edge. Pinned and vertically centered while the article scrolls.
   */
  .toc {
    position: fixed;
    top: 50%;
    /* 21rem = half of the article column (max-w-2xl); nudge just past its edge. */
    left: calc(50% + 21rem + 0.75rem);
    transform: translateY(-50%);
    z-index: 30;
    max-width: 14rem;
    max-height: 70vh;
    overflow-y: auto;
    display: none;
  }

  /* Only show once the viewport is wide enough to fit the column + the TOC. */
  @media (min-width: 1200px) {
    .toc {
      display: block;
    }
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc li + li {
    margin-top: 0.125rem;
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--color-zinc-500);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  /* Nest depth-3 under depth-2. */
  .toc-link.toc-d3 {
    padding-left: 1.25rem;
  }

  .toc-bar {
    flex: none;
    width: 0.75rem;
    height: 2px;
    /* Nudge down to line up with the first line of (possibly wrapped) text. */
    margin-top: 0.4375rem;
    border-radius: 9999px;
    background-color: var(--color-zinc-300);
    transition:
      width 0.15s ease,
      background-color 0.15s ease;
  }
  :global(.dark) .toc-bar {
    background-color: var(--color-zinc-700);
  }

  .toc-text {
    font-size: 0.8125rem;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-zinc-900);
    background-color: var(--color-zinc-100);
    outline: none;
  }
  :global(.dark) .toc-link:hover,
  :global(.dark) .toc-link:focus-visible {
    color: var(--color-zinc-100);
    background-color: var(--color-zinc-800);
  }
  .toc-link:hover .toc-bar,
  .toc-link:focus-visible .toc-bar {
    background-color: var(--color-sky-500);
  }

  /* Active section. */
  .toc-link.is-active {
    color: var(--color-sky-600);
  }
  :global(.dark) .toc-link.is-active {
    color: var(--color-sky-400);
  }
  .toc-link.is-active .toc-bar {
    width: 1.25rem;
    background-color: var(--color-sky-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .toc-bar {
      transition: none;
    }
  }
</style>

<script>
  // Deterministic scrollspy: the active section is the last heading whose top has
  // scrolled above an activation line near the top of the viewport. No dead zones,
  // no jitter between observer entries.
  const ACTIVATION_OFFSET = 96; // px from the top

  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-slug]'),
  );

  if (links.length) {
    const slugs = links.map((l) => l.dataset.slug ?? '');
    const headings = slugs.map((s) => document.getElementById(s));

    let activeSlug = '';
    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      for (const link of links) {
        link.classList.toggle('is-active', link.dataset.slug === slug);
      }
    };

    const computeActive = () => {
      let current = slugs[0];
      for (let i = 0; i < headings.length; i++) {
        const h = headings[i];
        if (h && h.getBoundingClientRect().top <= ACTIVATION_OFFSET) {
          current = slugs[i];
        } else {
          break;
        }
      }
      setActive(current);
    };

    // rAF-throttled scroll handler.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        computeActive();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Highlight immediately on click instead of waiting for the smooth scroll.
    for (const link of links) {
      link.addEventListener('click', () => setActive(link.dataset.slug ?? ''));
    }

    computeActive();
  }
</script>
