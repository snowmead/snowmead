---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="flex items-center justify-between gap-4 py-6">
  <a
    href="/"
    class="text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
  >
    {SITE_TITLE}
  </a>

  <nav class="flex items-center gap-1 text-sm">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-2.5 py-1.5 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100',
            isActive(link.href)
              ? 'font-medium text-zinc-900 dark:text-zinc-100'
              : 'text-zinc-500 dark:text-zinc-400',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>
