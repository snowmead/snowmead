---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page doesn't exist.">
  <div class="py-16 text-center">
    <p class="text-5xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      404
    </p>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">
      That page wandered off into the snow.
    </p>
    <a
      href="/"
      class="mt-8 inline-block text-sm text-sky-600 transition-colors hover:text-sky-500 dark:text-sky-400"
    >
      ← Back home
    </a>
  </div>
</Base>
